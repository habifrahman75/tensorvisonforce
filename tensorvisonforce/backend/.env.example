# ────────────────────────────────────────────────────────────────────
# CivicPulse Backend — Environment Variables
# Copy to .env and fill in your values before running the server.
# ────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=complaint-images

# ── JWT ──────────────────────────────────────────────────────────────
# Generate a secure random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ──────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
APP_NAME=CivicPulse Backend
API_V1_PREFIX=/api/v1

# ── CORS — comma-separated origins ───────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── AI / Classification ───────────────────────────────────────────────
CLASSIFICATION_MODEL_PATH=ai/data/complaint_training.csv
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.35

# ── Image processing ─────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MIN_IMAGE_RESOLUTION=480
BLUR_THRESHOLD=100.0

# ── Duplicate detection ───────────────────────────────────────────────
DUPLICATE_HASH_DISTANCE_THRESHOLD=8
DUPLICATE_LOCATION_RADIUS_METERS=500
DUPLICATE_TIME_WINDOW_HOURS=72

# ── SLA hours by priority ─────────────────────────────────────────────
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=48
SLA_HOURS_LOW=72
