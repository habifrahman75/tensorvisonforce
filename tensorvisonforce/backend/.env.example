# --- App ---
APP_NAME=Civic Complaint Backend
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security / JWT ---
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=complaint-images

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- AI / Classification ---
CLASSIFICATION_MODEL_PATH=ai/data/complaint_training.csv
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.35

# --- Image processing ---
MAX_UPLOAD_SIZE_MB=10
MIN_IMAGE_RESOLUTION=480
BLUR_THRESHOLD=100.0

# --- Duplicate detection ---
DUPLICATE_HASH_DISTANCE_THRESHOLD=8
DUPLICATE_LOCATION_RADIUS_METERS=50
DUPLICATE_TIME_WINDOW_HOURS=72

# --- SLA (hours, by priority) ---
SLA_HOURS_CRITICAL=24
SLA_HOURS_HIGH=72
SLA_HOURS_MEDIUM=168
SLA_HOURS_LOW=336
